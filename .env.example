# ── Bot Configuration ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# On Railway, you can set these in the Variables tab instead.
# ────────────────────────────────────────────────────────────────

BOT_TOKEN=your_bot_token_here
OWNER_ID=your_telegram_user_id
OWNER_USERNAME=your_username
KEYSYSTEM_URL=https://your-key-system.vercel.app/
KEYSYSTEM_ADMIN_SECRET=your_admin_secret_key
